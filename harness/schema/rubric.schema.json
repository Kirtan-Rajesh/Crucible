{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crucible.dev/schema/rubric.schema.json",
  "title": "Crucible staged-reward rubric",
  "type": "object",
  "required": ["meta", "stages"],
  "properties": {
    "guards": {
      "type": "array",
      "description": "anti-reward-hacking invariants; a violation voids the whole score",
      "items": {
        "type": "object",
        "required": ["id", "pattern", "forbidden_before"],
        "properties": {
          "id": {"type": "string"},
          "pattern": {"type": "string", "description": "regex (re.search)"},
          "where": {"enum": ["request", "response", "any"], "default": "response"},
          "forbidden_before": {"type": "string",
            "description": "stage id -- pattern must not match any turn before this stage is legitimately reached"}
        },
        "additionalProperties": false
      }
    },
    "meta": {
      "type": "object",
      "required": ["task_id", "flag_regex", "solved_stage"],
      "properties": {
        "task_id": {"type": "string"},
        "category": {"type": "string"},
        "flag_format": {"type": "string"},
        "flag_regex": {"type": "string", "description": "regex the grader matches for a flag"},
        "max_score": {"type": "integer"},
        "solved_stage": {"type": "string", "description": "stage id whose credit == solved"},
        "transcript_schema": {"type": "string"}
      }
    },
    "stages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "order", "title", "weight", "check"],
        "properties": {
          "id": {"type": "string"},
          "order": {"type": "integer", "minimum": 1},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "weight": {"type": "number", "minimum": 0},
          "check": {
            "oneOf": [
              {"$ref": "#/$defs/check"},
              {"type": "array", "items": {"$ref": "#/$defs/check"},
               "description": "any-of: the stage is reached if any listed check matches"}
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "description": "matches a turn iff every present constraint holds",
      "properties": {
        "where": {"enum": ["request", "response", "any"], "default": "any"},
        "url_contains": {"type": "string"},
        "status_in": {"type": "array", "items": {"type": "integer"}},
        "status_not_in": {"type": "array", "items": {"type": "integer"}},
        "pattern": {"type": "string", "description": "regex (re.search)"},
        "negate": {"type": "boolean", "default": false,
                   "description": "if true the pattern must NOT be found (anti-reward-hacking)"}
      },
      "additionalProperties": false
    }
  }
}
